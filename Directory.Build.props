<Project>

  <!-- The packages: the core and the four views go to nuget.org together, at the one Version below.
       .github/workflows/publish.yml, started by hand on GitHub, packs them, pushes them, and tags the
       commit with v and the Version. Projects are not packages unless they say so (IsPackable), so
       the hosts and DemoObjects stay out. The version has one owner, version.json
       (MAJOR.MINOR.PATCH.REVISION): Version is its public projection, which the tag and the packages
       carry; a new release raises version.json. -->
  <PropertyGroup>
    <PixieVersionJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.json'))</PixieVersionJson>
    <Version>$([System.Text.RegularExpressions.Regex]::Replace($(PixieVersionJson), '(?s).*"version"\s*:\s*"([0-9]+\.[0-9]+\.[0-9]+)\.[0-9]+".*', '$1'))</Version>
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Replace($(PixieVersionJson), '(?s).*"version"\s*:\s*"([0-9.]+)".*', '$1'))</FileVersion>
    <IsPackable>false</IsPackable>
    <Authors>Rafael Sakamoto</Authors>
    <Copyright>Copyright (c) 2026 Rafael Sakamoto</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sakamoto0110/PixieInspector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sakamoto0110/PixieInspector</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
